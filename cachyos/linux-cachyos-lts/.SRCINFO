pkgname = linux-cachyos-lts-ozel
	pkgdesc = The Linux EEVDF + Cachy Sauce Kernel by CachyOS with other patches and improvements - Long Term Service kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE

pkgname = linux-cachyos-lts-ozel-headers
	pkgdesc = Headers and scripts for building modules for the Linux EEVDF + Cachy Sauce Kernel by CachyOS with other patches and improvements - Long Term Service kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	depends = linux-cachyos-lts-ozel
	provides = LINUX-HEADERS

pkgname = linux-cachyos-lts-ozel-nvidia-open
	pkgdesc = nvidia open modules of 620.73.04 driver for the linux-cachyos-lts-ozel kernel
	license = MIT AND GPL-2.0-only
	depends = linux-cachyos-lts-ozel=6.18.65-1
	depends = nvidia-utils=620.73.04
	depends = libglvnd
	provides = NVIDIA-MODULE
	conflicts = linux-cachyos-lts-ozel-nvidia
	conflicts = linux-cachyos-lts-ozel-nvidia-580xx
